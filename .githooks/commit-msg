#!/bin/sh
# Enforce Conventional Commits on the commit message subject line, scoped to
# a skill in this catalog (or "repo" for changes not tied to one skill).
# See CLAUDE.md.

set -e

commit_msg_file="$1"

# Skip validation for merge commits: their subject line ("Merge branch ...")
# is generated by git itself, not written by hand.
git_dir=$(git rev-parse --git-dir 2>/dev/null) || git_dir=".git"
if [ -f "$git_dir/MERGE_HEAD" ]; then
  exit 0
fi

subject_line=$(head -n 1 "$commit_msg_file")

# fixup!/squash! commits are intentionally left unchecked: they exist to be
# squashed into a properly formatted commit before merging, not to stand on
# their own.
case "$subject_line" in
  "fixup! "*|"squash! "*) exit 0 ;;
esac

allowed_types="feat|fix|refactor|docs|chore|test|style|perf|build|ci|revert"
pattern="^(${allowed_types})\(([a-z0-9-]+)\)!?: .{1,100}$"

if ! echo "$subject_line" | grep -qE "$pattern"; then
  cat >&2 <<EOF
✗ Invalid commit message: it doesn't follow Conventional Commits.

  Got:
    $subject_line

  Expected format:
    <type>(<scope>): <description>

  allowed types: feat, fix, refactor, docs, chore, test, style, perf, build, ci, revert
  scope: name of the affected skill (an existing folder under skills/),
         or "repo" for changes not tied to a specific skill.

  Examples:
    feat(vue-webapp-standard): add dashboard reference
    fix(vue-webapp-standard): correct i18n locale fallback order
    docs(repo): update README

  See CLAUDE.md.
EOF
  exit 1
fi

scope=$(echo "$subject_line" | sed -E "s/$pattern/\2/")
repo_root=$(git rev-parse --show-toplevel)

if [ "$scope" != "repo" ] && [ ! -d "$repo_root/skills/$scope" ]; then
  echo "✗ Scope '$scope' doesn't match any skill under skills/ (nor 'repo')." >&2
  echo "  Check the skill name, or use 'repo' for changes not tied to a specific one." >&2
  exit 1
fi

exit 0
